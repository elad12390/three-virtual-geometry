{
  "name": "three-virtual-geometry",
  "version": "0.1.2",
  "description": "Virtual geometry for three.js WebGPU: automatic cluster LOD and GPU-driven culling for billions of triangles. Independent implementation, not affiliated with Epic Games.",
  "keywords": [
    "three",
    "threejs",
    "three.js",
    "webgpu",
    "virtual-geometry",
    "lod",
    "level-of-detail",
    "meshlet",
    "cluster",
    "culling",
    "occlusion-culling",
    "gpu-driven",
    "nanite",
    "tsl",
    "gltf"
  ],
  "homepage": "https://elad12390.github.io/three-virtual-geometry/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elad12390/three-virtual-geometry.git"
  },
  "bugs": {
    "url": "https://github.com/elad12390/three-virtual-geometry/issues"
  },
  "author": "Elad Ben-Haim <elad12390@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "vg-bake": "dist/bake.mjs"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "AGENTS.md",
    "docs/public/llms.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && npm run build:cli && npm run build:cdn",
    "build:demo": "vite build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bake": "node scripts/bake.mjs",
    "build:cli": "esbuild scripts/bake.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/bake.mjs --external:three --external:meshoptimizer \"--banner:js=#!/usr/bin/env node\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:types",
    "bench": "node scripts/bench.mjs",
    "build:cdn": "node scripts/build-cdn.mjs",
    "check:types": "attw --pack . --profile esm-only",
    "demo:scans": "node scripts/demos/scans.mjs",
    "demo:forest": "node scripts/demos/forest.mjs"
  },
  "peerDependencies": {
    "three": ">=0.180.0"
  },
  "dependencies": {
    "meshoptimizer": "^1.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  },
  "jsdelivr": "dist/three-virtual-geometry.all.min.js",
  "unpkg": "dist/three-virtual-geometry.all.min.js"
}
